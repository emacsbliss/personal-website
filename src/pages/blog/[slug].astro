---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  datePublished={post.data.datePublished}
  dateModified={post.data.dateModified}
>
  <Content />

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <nav class="post-nav">
    {prev && (
      <a href={`/blog/${prev.id}`} class="post-nav-link prev">
        <span class="direction">← Previous</span>
        <span class="nav-title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a href={`/blog/${next.id}`} class="post-nav-link next">
        <span class="direction">Next →</span>
        <span class="nav-title">{next.data.title}</span>
      </a>
    )}
  </nav>
</BlogPost>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s12);
    padding-top: var(--s8);
    border-top: 1px solid var(--border);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    background: var(--bg-secondary);
    padding: var(--s1) var(--s3);
    border-radius: 100px;
  }

  .post-nav {
    display: flex;
    gap: var(--s4);
    margin-top: var(--s12);
    padding-top: var(--s8);
    border-top: 1px solid var(--border);
  }

  .post-nav-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    text-decoration: none;
    padding: var(--s4);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.15s ease;

    &:hover {
      border-color: var(--fg-faint);
      .nav-title { color: var(--accent); }
    }

    &.next {
      text-align: right;
    }
  }

  .direction {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--fg);
    transition: color 0.15s ease;
  }

  @media (max-width: 480px) {
    .post-nav {
      flex-direction: column;
    }
  }
</style>
